# MongoDB Atlas connection string (server-only). Include the database name in the path.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/halloffantasy?retryWrites=true&w=majority

# Optional: overrides the database name in MONGODB_URI.
# MONGODB_DB=halloffantasy

# Required only for PRIVATE ESPN leagues. 32 random bytes, base64 or hex.
# Encrypts espn_s2/SWID while an import runs. Generate with: openssl rand -base64 32
ESPN_CREDENTIALS_KEY=
